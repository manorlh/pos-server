{
  "name": "r2m-kiosk-desktop",
  "productName": "R2M Kiosk",
  "version": "0.2.0",
  "description": "R2M POS for Windows (Electron): one app for every role the cloud gives the device - kiosk, KDS, order status board (till next) - offline, local media, Nayax LAN / SynqPay, SNBC ESC/POS printing, updates from the R2M cloud",
  "private": true,
  "author": "Runner Systems",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "start": "electron .",
    "dev": "node scripts/build-main.mjs --dev && vite build --mode development && electron .",
    "dev:web": "vite --mode web",
    "smoke": "node scripts/build-main.mjs --smoke && node dist/smoke/smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "1.7.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "il.co.runnersys.kiosk",
    "productName": "R2M Kiosk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**",
      "dist/preload/**",
      "dist/renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "R2M-POS-Windows-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "R2M POS"
    }
  }
}
