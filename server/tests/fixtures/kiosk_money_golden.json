      ]},
      "picks": [{"optionId": "a", "qty": 2, "pre": "extra"}, {"optionId": "b", "qty": 1, "pre": null}, {"optionId": "zz", "qty": 1, "pre": null}],
      "expected": {"charges": [400, 100, 0], "problems": ["quantity_not_allowed", "pre_not_allowed", "unknown_option", "above_max"], "unitAgorot": 500}
    },
    {
