      "group": {"id": "g-pita", "name": "לפיתה", "kind": "addon", "minSelect": 0, "maxSelect": 8, "freeCount": 2, "allowQuantity": true, "allowPre": false, "options": [
        {"id": "falafel", "name": "כדור פלאפל", "price": 2.5, "isDefault": false, "maxQty": 3},
        {"id": "egg", "name": "ביצה", "price": 3.0, "isDefault": false, "maxQty": null},
        {"id": "pickles", "name": "חמוצים", "price": 1.0, "isDefault": false, "maxQty": null}
      ]},
      "picks": [{"optionId": "falafel", "qty": 3, "pre": null}, {"optionId": "egg", "qty": 1, "pre": null}, {"optionId": "pickles", "qty": 2, "pre": null}],
      "expected": {"charges": [750, 300, 0], "problems": [], "unitAgorot": 2950, "canAddOne": {"falafel": false, "egg": true, "pickles": true}}
