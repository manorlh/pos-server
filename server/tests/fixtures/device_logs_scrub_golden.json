      "input": "PAN:4111111111111111;",
      "expected": "PAN:************1111;"
    },
    {
      "name": "two_cards_one_run",
      "input": "4111 1111 1111 1111 5555 5555 5555 4444",
      "expected": "************1111 ************4444"
    },
    {
