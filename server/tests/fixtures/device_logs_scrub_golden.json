      "expected": "amex ************0005"
    },
    {
      "name": "card_13_digits",
      "input": "old visa 4222222222222",
      "expected": "old visa ************2222"
    },
    {
      "name": "card_19_digits",
      "input": "unionpay 6221260000000000001 end",
      "expected": "unionpay ************0001 end"
    },
    {
      "name": "card_luhn_fails_kept",
