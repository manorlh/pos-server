    ],
    "itemView": [
      "sheet",
      "full",
      "modal",
      "inline",
      "steps",
      "popover"
    ],
    "quickAdd": [
      "off",
      "no_required",
      "always"
    ],
    "mealView": [
      "sheet",
      "steps",
      "tray"
    ],
    "mealUpsell": [
      "off",
      "first",
      "after"
    ],
    "basket": [
      "bar",
      "panel",
      "summary",
      "fab",
      "drawer",
      "receipt"
    ],
    "service": [
      "cards",
      "split",
      "rows",
      "sheet"
    ],
    "name": [
      "card",
      "dock",
      "avatar"
    ],
    "reach": [
      "normal",
      "low"
    ]
  },
  "defaults": {
    "template": "standard",
    "catalog": null,
    "categoryIcons": null,
    "railSize": "m",
    "landingColumns": 3,
    "landingShowCounts": true,
    "hero": "off",
    "magazineFeed": false,
    "card": null,
    "flow": "free",
    "itemView": "sheet",
    "quickAdd": "off",
    "mealView": "sheet",
    "mealUpsell": "off",
    "basket": null,
    "service": "cards",
    "name": "card",
    "nameAvatars": [],
    "reach": "normal",
    "reachToggle": false
  },
  "templates": {
    "standard": {
      "layout": {}
    },
    "guided": {
      "layout": {
        "catalog": "landing",
        "categoryIcons": "line",
        "flow": "guided",
        "itemView": "steps",
        "basket": "bar",
        "service": "cards",
        "name": "card",
        "card": "row",
        "landingColumns": 2
      }
    },
    "tabs": {
      "layout": {
        "catalog": "top",
        "categoryIcons": "filled",
        "itemView": "full",
        "basket": "bar",
        "service": "sheet",
        "name": "card"
      },
      "catalog": {
        "oneCategory": false
      }
    },
    "landing": {
      "layout": {
        "catalog": "landing",
        "categoryIcons": "duotone",
        "itemView": "modal",
        "basket": "summary",
        "service": "cards",
        "name": "card",
        "landingColumns": 3
      }
    },
    "fastfood": {
      "layout": {
        "catalog": "rail",
        "categoryIcons": "photo",
        "itemView": "sheet",
        "basket": "summary",
        "service": "split",
        "name": "card",
        "railSize": "l",
        "mealUpsell": "first",
        "card": "plate"
      }
    },
    "cafe": {
      "layout": {
        "catalog": "shelves",
        "categoryIcons": "emoji",
        "itemView": "full",
        "basket": "fab",
        "service": "rows",
        "name": "avatar",
        "hero": "manual"
      }
    },
    "combo": {
      "layout": {
        "catalog": "top",
        "categoryIcons": "filled",
        "itemView": "sheet",
        "basket": "summary",
        "service": "cards",
        "name": "card",
        "mealView": "tray"
      }
    },
    "list": {
      "layout": {
        "catalog": "list",
        "categoryIcons": "none",
        "itemView": "inline",
        "basket": "drawer",
        "service": "cards",
        "name": "dock"
      },
      "general": {
        "searchEnabled": true
      }
    },
    "magazine": {
      "layout": {
        "catalog": "magazine",
        "categoryIcons": "none",
        "itemView": "full",
        "basket": "bar",
        "service": "rows",
        "name": "card",
        "magazineFeed": true
      }
    },
    "wall": {
      "layout": {
        "catalog": "wall",
        "categoryIcons": "emoji",
        "itemView": "popover",
        "basket": "receipt",
        "name": "avatar",
        "quickAdd": "always"
      }
    }
  },
  "implemented": [
    "standard",
    "guided",
    "tabs",
    "landing",
    "fastfood"
  ],
  "backCompat": {
    "categoryLayout": {
      "rail": "side",
      "top": "top",
      "landing": "side",
      "list": "side",
      "shelves": "top",
      "magazine": "side",
      "wall": "side"
    },
    "cartStyle": {
      "bar": "bar",
      "panel": "panel",
      "summary": "bar",
      "fab": "bar",
      "drawer": "bar",
      "receipt": "bar"
    }
  },
  "welcome": {
    "vocabulary": {
      "position": [
        "top",
        "middle",
        "bottom"
      ],
      "align": [
        "start",
        "center",
        "end"
      ],
      "size": [
        "s",
        "m",
        "l",
        "xl"
      ],
      "weight": [
        "regular",
        "bold",
        "black"
      ],
      "backdrop": [
        "scrim",
        "card",
        "blur",
        "none"
      ]
    },
    "defaults": {
      "enabled": true,
      "position": "bottom",
      "align": "start",
      "size": "l",
      "weight": "black",
      "titleColor": null,
      "subtitleColor": null,
      "backdrop": "scrim",
      "showSubtitle": true,
      "maxWidthPct": 100
    },
    "maxWidthPct": {
      "min": 40,
      "max": 100
    }
  },
  "limits": {
    "nameAvatarsMax": 12,
    "nameAvatarMax": 24
  },
  "resolveCases": [
    {
      "name": "no layer: standard, the layout of today",
      "layers": [],
      "expect": {
        "layout.template": "standard",
        "layout.catalog": null,
        "layout.basket": null,
        "layout.flow": "free",
        "layout.itemView": "sheet",
        "theme.categoryLayout": "side",
        "theme.cartStyle": "bar",
        "catalog.oneCategory": true
      }
    },
    {
      "name": "the company picks tabs: chips at the top over one scrolling menu",
      "layers": [
        {
          "layout": {
            "template": "tabs"
          }
        }
      ],
      "expect": {
        "layout.catalog": "top",
        "layout.categoryIcons": "filled",
        "layout.itemView": "full",
        "layout.basket": "bar",
        "catalog.oneCategory": false,
        "theme.categoryLayout": "top",
        "theme.cartStyle": "bar"
      }
    },
    {
      "name": "fastfood in the classic style: the summary bar, a bar for an old kiosk",
      "layers": [
        {
          "theme": {
            "uiStyle": "classic"
          },
          "layout": {
            "template": "fastfood"
          }
        }
      ],
      "expect": {
        "layout.catalog": "rail",
        "layout.railSize": "l",
        "layout.mealUpsell": "first",
        "layout.basket": "summary",
        "layout.categoryIcons": "photo",
        "layout.card": "plate",
        "theme.categoryLayout": "side",
        "theme.cartStyle": "bar",
        "theme.uiStyle": "classic"
      }
    },
    {
      "name": "a shop's explicit key beats the company's template",
      "layers": [
        {
          "layout": {
            "template": "landing"
          }
        },
        {
          "layout": {
            "landingColumns": 2
          }
        }
      ],
      "expect": {
        "layout.template": "landing",
        "layout.catalog": "landing",
        "layout.landingColumns": 2,
        "layout.basket": "summary"
      }
    },
    {
      "name": "the kiosk picks another template; a key the company set itself stays",
      "layers": [
        {
          "layout": {
            "template": "tabs",
            "categoryIcons": "line"
          }
        },
        {},
        {
          "layout": {
            "template": "fastfood"
          }
        }
      ],
      "expect": {
        "layout.template": "fastfood",
        "layout.catalog": "rail",
        "layout.categoryIcons": "line",
        "catalog.oneCategory": true
      }
    },
    {
      "name": "guided with an inline dish is repaired to steps",
      "layers": [
        {
          "layout": {
            "template": "guided",
            "itemView": "inline"
          }
        }
      ],
      "expect": {
        "layout.flow": "guided",
        "layout.itemView": "steps",
        "layout.catalog": "landing",
        "layout.landingColumns": 2
      }
    },
    {
      "name": "reach low: the add-to-cart bounces (the flight would cross the display half)",
      "layers": [
        {
          "layout": {
            "reach": "low"
          }
        }
      ],
      "expect": {
        "layout.reach": "low",
        "motion.addToCart": "bounce"
      }
    },
    {
      "name": "reach low keeps a chosen none",
      "layers": [
        {
          "layout": {
            "reach": "low"
          },
          "motion": {
            "addToCart": "none"
          }
        }
      ],
      "expect": {
        "motion.addToCart": "none"
      }
    },
    {
      "name": "the wall template adds on a tap",
      "layers": [
        {
          "layout": {
            "template": "wall"
          }
        }
      ],
      "expect": {
        "layout.quickAdd": "always",
        "layout.catalog": "wall",
        "theme.categoryLayout": "side",
        "theme.cartStyle": "bar"
      }
    },
    {
      "name": "a wall of buttons adds on a tap at least without required choices",
      "layers": [
        {
          "layout": {
            "catalog": "wall",
            "quickAdd": "off"
          }
        }
      ],
      "expect": {
        "layout.quickAdd": "no_required"
      }
    },
    {
      "name": "the list template turns the search on",
      "layers": [
        {
          "layout": {
            "template": "list"
          }
        }
      ],
      "expect": {
        "general.searchEnabled": true,
        "layout.basket": "drawer"
      }
    },
    {
      "name": "a template's catalog replaces an explicit categoryLayout for old kiosks",
      "layers": [
        {
          "theme": {
            "categoryLayout": "top"
          },
          "layout": {
            "template": "landing"
          }
        }
      ],
      "expect": {
        "theme.categoryLayout": "side"
      }
    },
    {
      "name": "standard keeps an explicit categoryLayout and cartStyle",
      "layers": [
        {
          "theme": {
            "categoryLayout": "top",
            "cartStyle": "panel"
          }
        }
      ],
      "expect": {
        "theme.categoryLayout": "top",
        "theme.cartStyle": "panel",
        "layout.catalog": null,
        "layout.basket": null
      }
    },
    {
      "name": "shelves are a top strip and the fab a bar for an old kiosk",
      "layers": [
        {
          "layout": {
            "template": "cafe"
          }
        }
      ],
      "expect": {
        "theme.categoryLayout": "top",
        "theme.cartStyle": "bar",
        "layout.hero": "manual"
      }
    },
    {
      "name": "a panel basket is a panel for an old kiosk too",
      "layers": [
        {
          "layout": {
            "basket": "panel"
          }
        }
      ],
      "expect": {
        "theme.cartStyle": "panel"
      }
    }
  ],
  "parseCases": [
    {
      "name": "no layout at all (an older cloud): the layout of today",
      "layout": null,
      "expect": {
        "template": "standard",
        "catalog": null,
        "categoryIcons": null,
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": null,
        "flow": "free",
        "itemView": "sheet",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": null,
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    },
    {
      "name": "only the template (an older cloud): the template's own keys",
      "layout": {
        "template": "tabs"
