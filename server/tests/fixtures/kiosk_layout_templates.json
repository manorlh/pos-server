  "resolveCases": [
    {
      "name": "no layer: standard, the layout of today",
      "layers": [],
      "expect": {
        "layout.template": "standard",
        "layout.catalog": null,
        "layout.basket": null,
        "layout.flow": "free",
        "layout.itemView": "sheet",
        "theme.categoryLayout": "side",
        "theme.cartStyle": "bar",
        "catalog.oneCategory": true
      }
    },
    {
      "name": "the company picks tabs: chips at the top over one scrolling menu",
      "layers": [
        {
          "layout": {
            "template": "tabs"
          }
        }
      ],
      "expect": {
        "layout.catalog": "top",
        "layout.categoryIcons": "filled",
        "layout.itemView": "full",
        "layout.basket": "bar",
        "catalog.oneCategory": false,
        "theme.categoryLayout": "top",
        "theme.cartStyle": "bar"
      }
    },
    {
      "name": "fastfood in the classic style: the summary bar, a bar for an old kiosk",
      "layers": [
        {
          "theme": {
            "uiStyle": "classic"
          },
          "layout": {
            "template": "fastfood"
          }
        }
      ],
      "expect": {
        "layout.catalog": "rail",
        "layout.railSize": "l",
        "layout.mealUpsell": "first",
        "layout.basket": "summary",
        "layout.categoryIcons": "photo",
        "layout.card": "plate",
        "theme.categoryLayout": "side",
        "theme.cartStyle": "bar",
        "theme.uiStyle": "classic"
      }
    },
    {
      "name": "a shop's explicit key beats the company's template",
      "layers": [
        {
          "layout": {
            "template": "landing"
          }
        },
        {
          "layout": {
            "landingColumns": 2
          }
        }
      ],
      "expect": {
        "layout.template": "landing",
        "layout.catalog": "landing",
        "layout.landingColumns": 2,
        "layout.basket": "summary"
      }
    },
    {
      "name": "the kiosk picks another template; a key the company set itself stays",
      "layers": [
        {
          "layout": {
            "template": "tabs",
            "categoryIcons": "line"
          }
        },
        {},
        {
          "layout": {
            "template": "fastfood"
          }
        }
      ],
      "expect": {
        "layout.template": "fastfood",
        "layout.catalog": "rail",
        "layout.categoryIcons": "line",
        "catalog.oneCategory": true
      }
    },
    {
      "name": "guided with an inline dish is repaired to steps",
      "layers": [
        {
          "layout": {
            "template": "guided",
            "itemView": "inline"
          }
        }
      ],
      "expect": {
        "layout.flow": "guided",
        "layout.itemView": "steps",
        "layout.catalog": "landing",
        "layout.landingColumns": 2
      }
    },
    {
      "name": "reach low: the add-to-cart bounces (the flight would cross the display half)",
      "layers": [
        {
          "layout": {
            "reach": "low"
          }
        }
      ],
      "expect": {
        "layout.reach": "low",
        "motion.addToCart": "bounce"
      }
    },
    {
      "name": "reach low keeps a chosen none",
      "layers": [
        {
          "layout": {
            "reach": "low"
          },
          "motion": {
            "addToCart": "none"
          }
        }
      ],
      "expect": {
        "motion.addToCart": "none"
      }
    },
    {
      "name": "the wall template adds on a tap",
      "layers": [
        {
          "layout": {
            "template": "wall"
          }
        }
      ],
      "expect": {
        "layout.quickAdd": "always",
        "layout.catalog": "wall",
        "theme.categoryLayout": "side",
        "theme.cartStyle": "bar"
      }
    },
    {
      "name": "a wall of buttons adds on a tap at least without required choices",
      "layers": [
        {
          "layout": {
            "catalog": "wall",
            "quickAdd": "off"
          }
        }
      ],
      "expect": {
        "layout.quickAdd": "no_required"
      }
    },
    {
      "name": "the list template turns the search on",
      "layers": [
        {
          "layout": {
            "template": "list"
          }
        }
      ],
      "expect": {
        "general.searchEnabled": true,
        "layout.basket": "drawer"
      }
    },
    {
      "name": "a template's catalog replaces an explicit categoryLayout for old kiosks",
      "layers": [
        {
          "theme": {
            "categoryLayout": "top"
          },
          "layout": {
            "template": "landing"
          }
        }
      ],
      "expect": {
        "theme.categoryLayout": "side"
      }
    },
    {
      "name": "standard keeps an explicit categoryLayout and cartStyle",
      "layers": [
        {
          "theme": {
            "categoryLayout": "top",
            "cartStyle": "panel"
          }
        }
      ],
      "expect": {
        "theme.categoryLayout": "top",
        "theme.cartStyle": "panel",
        "layout.catalog": null,
        "layout.basket": null
      }
    },
    {
      "name": "shelves are a top strip and the fab a bar for an old kiosk",
      "layers": [
        {
          "layout": {
            "template": "cafe"
          }
        }
      ],
      "expect": {
        "theme.categoryLayout": "top",
        "theme.cartStyle": "bar",
        "layout.hero": "manual"
      }
    },
    {
      "name": "a panel basket is a panel for an old kiosk too",
      "layers": [
        {
          "layout": {
            "basket": "panel"
          }
        }
      ],
      "expect": {
        "theme.cartStyle": "panel"
      }
    },
    {
      "name": "restaurant_rail: the rail of circles over one continuous menu, a side rail for an old kiosk",
      "layers": [
        {
          "layout": {
            "template": "restaurant_rail"
          }
        }
      ],
      "expect": {
        "layout.catalog": "rail",
        "layout.railStyle": "circle",
        "layout.railEmphasis": "fill_scale",
        "layout.catalogScroll": "continuous",
        "layout.pricePill": "on",
        "layout.sheetMotion": "slide_up",
        "layout.topBar": [
          "club",
          "cancel",
          "search"
        ],
        "layout.doneScreen": "card",
        "layout.payMethodView": "sheet",
        "layout.helpButton": "off",
        "theme.categoryLayout": "side",
        "catalog.oneCategory": false,
        "motion.sheet": "scale"
      }
    },
    {
      "name": "restaurant_rail: a shop's explicit oneCategory and sheetMotion beat the template",
      "layers": [
        {
          "layout": {
            "template": "restaurant_rail"
          }
        },
        {
          "catalog": {
            "oneCategory": true
          },
          "layout": {
            "sheetMotion": "fade",
            "pricePill": "off"
          }
        }
      ],
      "expect": {
        "layout.catalogScroll": "continuous",
        "catalog.oneCategory": true,
        "layout.sheetMotion": "fade",
        "layout.pricePill": "off"
      }
    },
    {
      "name": "the new keys stay today's under every older template",
      "layers": [
        {
          "layout": {
            "template": "fastfood"
          }
        }
      ],
      "expect": {
        "layout.railStyle": "plain",
        "layout.catalogScroll": "paged",
        "layout.pricePill": "off",
        "layout.sheetMotion": null,
        "layout.topBar": null,
        "layout.helpButton": "off",
        "layout.doneScreen": "classic",
        "layout.payMethodView": "screen"
      }
    },
    {
      "name": "the count badge is on in every template by default",
      "layers": [
        {
          "layout": {
            "template": "magazine"
          }
        }
      ],
      "expect": {
        "layout.cartCountBadge": true,
        "layout.quickAdd": "off"
      }
    },
    {
      "name": "a shop turns the count badge off; the wall still adds on a tap",
      "layers": [
        {
          "layout": {
            "template": "wall"
          }
        },
        {
          "layout": {
            "cartCountBadge": false
          }
        }
      ],
      "expect": {
        "layout.cartCountBadge": false,
        "layout.quickAdd": "always"
      }
    },
    {
      "name": "a kiosk turns the count badge back on over its shop",
      "layers": [
        {},
        {
          "layout": {
            "cartCountBadge": false
          }
        },
        {
          "layout": {
            "cartCountBadge": true
          }
        }
      ],
      "expect": {
        "layout.cartCountBadge": true
      }
    }
  ],
