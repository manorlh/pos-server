      "expect": {
        "template": "tabs",
        "catalog": "top",
        "categoryIcons": "filled",
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": null,
        "flow": "free",
        "itemView": "full",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": "bar",
        "service": "sheet",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    },
    {
      "name": "a template and one key of its own",
      "layout": {
        "template": "fastfood",
        "railSize": "m"
      },
      "expect": {
        "template": "fastfood",
        "catalog": "rail",
        "categoryIcons": "photo",
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": "plate",
        "flow": "free",
        "itemView": "sheet",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "first",
        "basket": "summary",
        "service": "split",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    },
    {
      "name": "an unknown template is standard; a known key still counts",
      "layout": {
        "template": "spaceship",
        "catalog": "top"
      },
      "expect": {
        "template": "standard",
        "catalog": "top",
        "categoryIcons": null,
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": null,
        "flow": "free",
        "itemView": "sheet",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": null,
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    },
    {
      "name": "an unknown value is the template's (null here); a known one stays",
      "layout": {
        "catalog": "bogus",
        "basket": "panel",
        "landingColumns": 7
      },
      "expect": {
        "template": "standard",
        "catalog": null,
        "categoryIcons": null,
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": null,
        "flow": "free",
        "itemView": "sheet",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": "panel",
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    },
    {
      "name": "an explicit null is the template's value",
      "layout": {
        "template": "landing",
        "basket": null
      },
      "expect": {
        "template": "landing",
        "catalog": "landing",
        "categoryIcons": "duotone",
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": null,
        "flow": "free",
        "itemView": "modal",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": "summary",
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    },
    {
      "name": "the accessible mode and its toggle",
      "layout": {
        "reach": "low",
        "reachToggle": true
      },
      "expect": {
        "template": "standard",
        "catalog": null,
        "categoryIcons": null,
        "railSize": "m",
        "landingColumns": 3,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": null,
        "flow": "free",
        "itemView": "sheet",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": null,
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "low",
        "reachToggle": true
      }
    },
    {
      "name": "the guided flow, complete as the cloud sends it",
      "layout": {
        "template": "guided",
        "catalog": "landing",
        "categoryIcons": "line",
        "railSize": "m",
        "landingColumns": 2,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": "row",
        "flow": "guided",
        "itemView": "steps",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": "bar",
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      },
      "expect": {
        "template": "guided",
        "catalog": "landing",
        "categoryIcons": "line",
        "railSize": "m",
        "landingColumns": 2,
        "landingShowCounts": true,
        "hero": "off",
        "magazineFeed": false,
        "card": "row",
        "flow": "guided",
        "itemView": "steps",
        "quickAdd": "off",
        "mealView": "sheet",
        "mealUpsell": "off",
        "basket": "bar",
        "service": "cards",
        "name": "card",
        "nameAvatars": [],
        "reach": "normal",
        "reachToggle": false
      }
    }
  ]
}
