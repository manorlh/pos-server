      "filled",
      "duotone",
      "emoji",
      "none"
    ],
    "railSize": [
      "s",
      "m",
      "l"
    ],
    "landingColumns": [
      2,
      3,
      4
    ],
    "hero": [
      "off",
      "manual",
      "auto"
