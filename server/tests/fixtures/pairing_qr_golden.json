{
  "spec": "pos-server docs/SPEC_PAIRING_QR.md",
  "description": "Shared golden cases for the pairing-code QR the dashboard draws (client/src/lib/pairingCodeQr.ts builds it) and the till's reading of it (DashboardPairingQr.kt). The same bytes in pos-server tests/fixtures and pos-android app/src/test/resources; both tests pin the LF-normalised SHA-256.",
  "version": 1,
  "format": "r2mpos://pair?v=1&server=<percent-encoded API base>&code=<CODE>&exp=<epoch seconds>",
  "build": [
    {
      "name": "the production shape: an https API base with its /api/v1 path",
      "server": "https://api.r2m-pos.example/api/v1",
      "code": "QR7F4K2M",
      "exp": 1791634500,
      "payload": "r2mpos://pair?v=1&server=https%3A%2F%2Fapi.r2m-pos.example%2Fapi%2Fv1&code=QR7F4K2M&exp=1791634500"
    },
    {
      "name": "a LAN install: http, a private address and a port",
      "server": "http://192.168.1.20:8001/api/v1",
      "code": "AB12CD34",
      "exp": 1791634500,
      "payload": "r2mpos://pair?v=1&server=http%3A%2F%2F192.168.1.20%3A8001%2Fapi%2Fv1&code=AB12CD34&exp=1791634500"
    },
    {
      "name": "a bare host: the till adds /api/v1 itself when it connects",
      "server": "https://pos.example.co.il",
      "code": "ZZ9TEST1",
      "exp": 1791634500,
      "payload": "r2mpos://pair?v=1&server=https%3A%2F%2Fpos.example.co.il&code=ZZ9TEST1&exp=1791634500"
    },
    {
      "name": "a trailing slash is dropped from the address",
      "server": "https://api.r2m-pos.example/api/v1/",
      "code": "QR7F4K2M",
      "exp": 1791634500,
      "payload": "r2mpos://pair?v=1&server=https%3A%2F%2Fapi.r2m-pos.example%2Fapi%2Fv1&code=QR7F4K2M&exp=1791634500"
    }
  ],
