  "parse": [
    {
      "name": "the QR the dashboard draws, scanned a minute before it expires",
      "payload": "r2mpos://pair?v=1&server=https%3A%2F%2Fapi.r2m-pos.example%2Fapi%2Fv1&code=QR7F4K2M&exp=1791634500",
      "now": 1791634440,
      "result": {
        "outcome": "valid",
        "server": "https://api.r2m-pos.example/api/v1",
        "code": "QR7F4K2M",
        "exp": 1791634500
      }
    },
    {
      "name": "scanned at the very second it expires: still good",
      "payload": "r2mpos://pair?v=1&server=https%3A%2F%2Fapi.r2m-pos.example%2Fapi%2Fv1&code=QR7F4K2M&exp=1791634500",
      "now": 1791634500,
      "result": {
        "outcome": "valid",
