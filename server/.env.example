# Database
# For local docker: copy .env.local.example → .env.local (overrides this file).
DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ably realtime notify — lightweight wake-ups for POS (catalog/settings/users).
# Create an app at ably.com → API Keys → copy the full key (appId.keySecret).
# Enable "Persist last message" on channel namespace `pos:*` in Ably dashboard.
ABLY_API_KEY=

# Clerk (get from clerk.com → your app → API Keys)
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# First Clerk sign-in auto-creates user + tenant when no invite exists (set false for invite-only prod)
ALLOW_SELF_SERVICE_SIGNUP=true

# Cloudinary — required for product image upload
# Dashboard: GET /images/upload-params → signed upload to api.cloudinary.com
# Get from cloudinary.com console → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO
# LOG_REQUEST_BODIES=true logs JSON/text request bodies + error response bodies + the answers to the till's sync writes (transactions, shifts, close, ack) (redacted, truncated)
LOG_REQUEST_BODIES=false
LOG_BODY_MAX_BYTES=4096
CORS_ORIGINS=["https://pos-cloud-app.vercel.app","http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:8080"]

# Pairing
PAIRING_CODE_LENGTH=8
PAIRING_CODE_EXPIRY_MINUTES=15
PAIRING_SESSION_EXPIRE_HOURS=12
DEVICE_PAIRING_NONCE_EXPIRE_MINUTES=15
PAIRING_MOBILE_APP_BASE_URL=https://pos-cloud-app.vercel.app
MACHINE_TOKEN_EXPIRE_DAYS=365
PORT=8001